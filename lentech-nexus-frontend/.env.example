# Lentech Nexus frontend environment variables.
# Copy this file to `.env` only for production builds.
#
# Leave UNSET in development: the Vite dev server proxies `/api` to the Django
# server, so the browser only ever talks to one origin.
#
# For production (served from a different origin than the API), set the full URL:
# VITE_API_BASE_URL=https://api.example.com
