# Lentech Nexus backend environment variables.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Core Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Development defaults to SQLite. To use PostgreSQL set DB_ENGINE=postgres.
DB_ENGINE=sqlite
DB_NAME=lentech_nexus
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# --- CORS / CSRF (frontend origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Cloudinary (profile + post image/video storage) ---
# Leave CLOUDINARY_ENABLED=False to keep uploads disabled locally.
# When enabled, set all three values from your Cloudinary dashboard.
CLOUDINARY_ENABLED=False
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=lentech_nexus/media

# --- Upload constraints (megabytes) ---
MAX_PROFILE_IMAGE_MB=5
MAX_POST_IMAGE_MB=8
MAX_POST_VIDEO_MB=25

# --- Security (production only; ignored while DEBUG=True) ---
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
